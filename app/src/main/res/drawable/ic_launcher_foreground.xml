<?xml version="1.0" encoding="utf-8"?>
<!-- Monogram V pita yang menyamai simbol pada logo header; tanpa wordmark dan tanpa cincin badge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Pita silver: bidang kiri yang melipat ke dasar V. -->
    <path android:pathData="M22,25 L37,25 L54,61 L60,73 C56,83 49,85 43,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startY="24" android:endY="84" android:type="linear">
                <item android:color="#F7F8FA" android:offset="0" />
                <item android:color="#AEB8C6" android:offset="0.54" />
                <item android:color="#53647B" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Pita electric blue: bidang kanan yang menutup lipatan V. -->
    <path android:pathData="M69,25 L86,25 L65,68 C61,77 57,82 51,83 C56,79 58,74 60,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startY="25" android:endY="83" android:type="linear">
                <item android:color="#182333" android:offset="0" />
                <item android:color="#0B55D8" android:offset="0.58" />
                <item android:color="#5E9BFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Highlight tip untuk mempertahankan kesan material tanpa glow berlebihan. -->
    <path
        android:fillColor="#BFD5FF"
        android:fillAlpha="0.72"
        android:pathData="M69,25 L86,25 L83,29 L70,29 L59,64 L57,64 Z" />
</vector>
