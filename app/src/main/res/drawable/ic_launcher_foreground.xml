<?xml version="1.0" encoding="utf-8"?>
<!--
  Emblem Velum untuk lapisan adaptif (kanvas 108x108): cincin emas + monogram "V".

  Bentuknya harus identik dengan PNG legacy (mipmap-*/ic_launcher{,_round}.png):
  - cincin luar 32,4 / dalam 29,6 dari pusat (54,54), gradien gading-emas terang
    di atas lalu amber gelap di bawah (kesan logam terkena cahaya dari atas);
  - monogram "V" gradien champagne -> amber.

  Seluruh bentuk berada di dalam zona aman 72x72 (cincin diameter 64,8), sehingga
  topeng peluncur apa pun — bulat, squircle, kotak membulat — tidak memotongnya.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cincin: dua lingkaran dengan fillType evenOdd, gradien vertikal. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,21.6 a32.4,32.4 0 1,1 -0.01,0 z M54,24.4 a29.6,29.6 0 1,0 0.01,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endY="86.4"
                android:startY="21.6"
                android:type="linear">
                <item
                    android:color="@color/icon_ring_start"
                    android:offset="0" />
                <item
                    android:color="@color/icon_ring_end"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Monogram "V" di dalam cincin. -->
    <path android:pathData="M40.5,42 L47.1,42 L54,60 L60.9,42 L67.5,42 L58.5,68 L49.5,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endY="68"
                android:startY="42"
                android:type="linear">
                <item
                    android:color="@color/icon_monogram_start"
                    android:offset="0" />
                <item
                    android:color="@color/icon_monogram_end"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
