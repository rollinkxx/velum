<?xml version="1.0" encoding="utf-8"?>
<!-- Penanda baris aksi: dua goresan berujung bulat yang dirotasi ±45 derajat. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="45">
        <path
            android:pathData="M12,6.2 L12,12"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="2.2" />
    </group>
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-45">
        <path
            android:pathData="M12,6.2 L12,12"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="2.2" />
    </group>
</vector>
