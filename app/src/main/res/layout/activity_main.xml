<?xml version="1.0" encoding="utf-8"?>
<!--
  Layar utama — TETAP (tanpa menggulir) atas permintaan maintainer: satu layar penuh
  yang selalu muat. Konsekuensi yang diterima sadar: pada layar sangat pendek atau
  skala huruf sangat besar, isi bisa terpotong karena tidak ada gulir.

  Hirarki bersih (audit & refaktor 2026-09-13), dua bagian utama:
    root (vertikal, center_horizontal)
    ├─ header (vertikal, wrap_content, center) : judul dua lapis + tagline
    └─ isi   (vertikal, weight=1, center)      : pembatas, kartu status, tombol, menu

  Tinggi ditekan (status sebaris, kartu rapat, baris aksi 52dp) agar semua muat.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <!-- ===== Header: judul + tagline dalam satu kolom rata tengah ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!--
          Judul dua lapis (kesan timbul 3D): lapisan gelap bergeser sedikit turun di
          belakang lapisan depan bergradien gading-emas. Keduanya WAJIB satu baris:
          maxLines=1 + auto-size 48-106sp + letter-spacing 0.15.

          JANGAN menambahkan singleLine="true" di sini. `TextView.applySingleLine()`
          memanggil `setHorizontallyScrolling(true)` (TextView.java:12391-12396), dan
          begitu view horizontally scrollable, AppCompat menghitung lebar tersedia
          untuk auto-size sebagai VERY_WIDE, bukan lebar view
          (AppCompatTextViewAutoSizeHelper, "final int availableWidth =
          horizontallyScrolling ? VERY_WIDE : getMeasuredWidth() - padding").
          Akibatnya setiap ukuran dianggap "muat": batas atas 106sp selalu dipilih,
          teks meluber melewati lebar layar, lalu terpotong — persis gejala "Vel…"
          yang dilaporkan maintainer 2026-09-13 pada build 20d3a07. maxLines=1 sudah
          cukup untuk melarang pembungkusan tanpa mematikan auto-size.
          includeFontPadding=false menghapus ruang kosong bawaan font.

          Lebar judul sengaja match_parent (bukan wrap_content) dan batas atas
          auto-size dinaikkan ke 106sp (dari 80sp, 2026-09-13 atas permintaan
          maintainer: "title ukurannya lebih besar"): pada lebar 371dp area isi
          (411dp - 2x20dp padding), "Velum" 3,54 em baru melewati lebar itu di
          ~105sp, jadi lebar-lah yang menjadi pengikat dan judul selalu membentang
          selebar area isi seperti pada referensi maintainer. Ini juga membuat
          ukuran TERLIHAT tidak bergantung skala font perangkat: pada fontScale
          lebih besar auto-size memilih sp lebih kecil dengan hasil dp yang sama.
          autoSizeMinTextSize 48sp tetap menjaga layar sangat sempit.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/appTitleShadow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:translationX="2dp"
                android:translationY="3dp"
                android:fontFamily="sans-serif-light"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:letterSpacing="0.15"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/title_shadow"
                android:textSize="106sp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="48sp"
                app:autoSizeMaxTextSize="106sp"
                app:autoSizeStepGranularity="1sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/appTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:letterSpacing="0.15"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/fg"
                android:textSize="106sp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="48sp"
                app:autoSizeMaxTextSize="106sp"
                app:autoSizeStepGranularity="1sp" />
        </FrameLayout>

        <!--
          marginTop NEGATIF disengaja: kotak baris judul selalu lebih tinggi daripada
          tintanya (Roboto: 2701/2048 em kotak vs 1456/2048 em tinggi huruf kapital),
          jadi sisa ruang di bawah baseline (555/2048 em) + ruang di atas huruf tagline
          ((2146-1456)/2048 em) menambah jarak yang terlihat tanpa diminta.

          Rumus jarak terlihat (bukan tafsiran; em dari hhea/OS-2 Roboto):
            jarak = marginTop + (555/2048)*judul_efektif + ((2146-1456)/2048)*11
          Dengan judul yang membentang selebar area isi (~104,7sp pada fontScale 1,0)
          dan target jarak 14dp: marginTop = 14 - 28,4 - 3,7 = -18dp.
          Nilai ini stabil lintas fontScale karena auto-size menahan tinggi judul (dp)
          tetap sama walau sp yang dipilih berbeda.
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-18dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.28"
            android:text="@string/app_tagline"
            android:textAllCaps="true"
            android:textColor="@color/accent_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ===== Isi: dipusatkan vertikal di ruang yang tersisa di bawah header ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="vertical">

        <View
            android:layout_width="52dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/divider_gold" />

        <!-- Kartu status: padding simetris (atas = bawah = 10dp, kiri = kanan = 16dp). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <!-- Badge status: titik + teks sejajar garis tengah, badge di tengah kartu. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/dot_off"
                    android:contentDescription="@string/cd_status_down" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="@string/status_disconnected"
                    android:textColor="@color/fg"
                    android:textSize="14sp" />
            </LinearLayout>

            <!--
              visibility="gone" sejak awal: VelumController memang mengosongkan baris ini
              lewat setMessage("") (dua tempat), dan teks kosong TETAP memesan tinggi
              kotak (~20,6dp) sehingga badge "Tersambung" tampak melayang dengan ruang
              tak seimbang di bawahnya. MainActivity.setMessage() yang menjaga
              GONE/VISIBLE; saat ada pesan, tampilannya persis seperti sebelumnya.
            -->
            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:visibility="gone"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="3"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/card_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/info_duration"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/infoDuration"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="2"
                        android:text="@string/value_none"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/info_endpoint"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/infoEndpoint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="2"
                        android:text="@string/value_none"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/info_last_test"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/infoTest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="2"
                        android:text="@string/value_none"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/info_data"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/infoData"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="2"
                        android:text="@string/value_none"
                        android:textColor="@color/fg"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            android:minHeight="52dp"
            android:text="@string/btn_connect"
            android:textAllCaps="false"
            android:textColor="@color/btn_primary_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_outline"
            android:minHeight="52dp"
            android:text="@string/btn_test"
            android:textAllCaps="false"
            android:textColor="@color/btn_outline_text"
            android:textSize="15sp" />

        <!-- Kartu baris aksi: satu baris = satu tujuan, tanpa gulir di dalamnya. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/reset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/btn_reset"
                        android:textColor="@color/fg"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="@string/sub_reset"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/outline" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="50dp"
                android:background="@color/card_stroke" />

            <LinearLayout
                android:id="@+id/vpnSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/btn_vpn_settings"
                        android:textColor="@color/fg"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/subVpnSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="@string/sub_vpn_settings"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/outline" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="50dp"
                android:background="@color/card_stroke" />

            <LinearLayout
                android:id="@+id/exclusions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_apps"
                    app:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/btn_exclusions"
                        android:textColor="@color/fg"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="@string/sub_exclusions"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/outline" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="50dp"
                android:background="@color/card_stroke" />

            <LinearLayout
                android:id="@+id/copyDiag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/btn_copy_diag"
                        android:textColor="@color/fg"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="@string/sub_copy_diag"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron"
                    app:tint="@color/outline" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
