<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Style bersama agar empat baris status tetap konsisten dan mudah dirawat. -->
    <style name="StatusInfoLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="StatusInfoValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1.5</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
